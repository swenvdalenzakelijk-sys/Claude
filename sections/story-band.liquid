<section class="band" id="story">
  <div class="ring-big"></div>
  <div class="container band-inner">
    <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    <p>{{ section.settings.body }}</p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="btn btn-outline" style="border-color:#fff;color:#fff;">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Story band",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (use \\n for line break)",
      "default": "Built on the barrier, not behind a desk"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "CAPSLOCK started as a running joke in a group chat — when something really matters, you type it in all caps. So we put that energy on a cap: the no-smoking icon everyone ignores, turned into the one accessory everyone actually wants. No hype drops, no gimmicks. Just caps loud enough to survive a weekend of sets."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    }
  ]
}
{% endschema %}
