<section class="section page-hero">
  <div class="container">
    <div class="eyebrow">{{ section.settings.hero_eyebrow }}</div>
    <h1>{{ section.settings.hero_heading }}</h1>
    <p>{{ section.settings.hero_subtext }}</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-side">
        <h2>{{ section.settings.side_heading }}</h2>
        <p>{{ section.settings.side_body }}</p>

        {% for block in section.blocks %}
          {% if block.type == 'info_item' %}
            <div class="contact-item"{{ block.shopify_attributes }}>
              <div class="ci-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
              </div>
              <div>
                <h4>{{ block.settings.label }}</h4>
                <p>{{ block.settings.value }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="form-card">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <p style="margin-bottom:20px; color:var(--red); font-weight:600;">{{ section.settings.success_message }}</p>
          {% endif %}
          {% if form.errors %}
            <p style="margin-bottom:20px; color:var(--red);">{{ form.errors | default_errors }}</p>
          {% endif %}
          <div class="form-row">
            <label for="ContactFormName">Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" placeholder="Your name" value="{% if form.name %}{{ form.name }}{% endif %}" required>
          </div>
          <div class="form-row">
            <label for="ContactFormEmail">Email</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="you@email.com" value="{% if form.email %}{{ form.email }}{% endif %}" required>
          </div>
          <div class="form-row">
            <label for="ContactFormMessage">Message</label>
            <textarea id="ContactFormMessage" name="contact[body]" placeholder="What's on your mind?" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
          <button type="submit" class="btn btn-primary form-submit">{{ section.settings.submit_label }}</button>
          <p class="form-note">By submitting, you agree to our <a href="{{ section.settings.privacy_link }}" style="text-decoration:underline;">Privacy Policy</a>.</p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Say it in all caps, or don't — we'll still hear you" },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero subtext", "default": "Questions about an order, sizing, or a festival collab? Drop us a message and we'll get back to you within 1 business day." },
    { "type": "text", "id": "side_heading", "label": "Side panel heading", "default": "Other ways to reach us" },
    { "type": "textarea", "id": "side_body", "label": "Side panel body", "default": "Prefer not to fill in a form? Here's where else to find us — we check all of these daily." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — your message is on its way. We'll reply within 1 business day." },
    { "type": "url", "id": "privacy_link", "label": "Privacy policy link", "default": "/pages/privacy-policy" }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "Info item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "info_item", "settings": { "label": "Email", "value": "hello@capslock.com" } },
      { "type": "info_item", "settings": { "label": "Response time", "value": "Within 1 business day, Mon–Fri" } },
      { "type": "info_item", "settings": { "label": "Based in", "value": "Designed and shipped from the Netherlands" } }
    ]
  },
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
