<section class="section page-hero">
  <div class="container">
    <div class="eyebrow">{{ section.settings.hero_eyebrow }}</div>
    <h1>{{ section.settings.hero_heading }}</h1>
    <p>{{ section.settings.hero_subtext }}</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">

    <div class="ship-cards">
      {% for block in section.blocks %}
        {% if block.type == 'ship_method' %}
          <div class="ship-card {% if block.settings.emphasize %}express{% endif %}"{{ block.shopify_attributes }}>
            <span class="tag-new" style="{% unless block.settings.emphasize %}background:var(--ink);{% endunless %}">{{ block.settings.tag }}</span>
            <h3>{{ block.settings.title }}</h3>
            <div class="price">{{ block.settings.price_line }}</div>
            <ul>
              {% assign lines = block.settings.details | newline_to_br | split: '<br />' %}
              {% for line in lines %}
                {% if line != blank %}<li>{{ line | strip }}</li>{% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="section-head" style="margin-bottom:24px;">
      <h2>{{ section.settings.countries_heading }}</h2>
      <p>{{ section.settings.countries_subtext }}</p>
    </div>
    <div class="country-row">
      {% for block in section.blocks %}
        {% if block.type == 'country' %}
          <div class="country-chip"{{ block.shopify_attributes }}>{{ block.settings.name }}</div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="section-head" style="margin-bottom:24px;">
      <h2>{{ section.settings.info_heading }}</h2>
      <p>{{ section.settings.info_subtext }}</p>
    </div>
    <table class="info-table">
      {% for block in section.blocks %}
        {% if block.type == 'info_row' %}
          <tr><th>{{ block.settings.label }}</th><td>{{ block.settings.value }}</td></tr>
        {% endif %}
      {% endfor %}
    </table>

    <div class="accordion">
      {% for block in section.blocks %}
        {% if block.type == 'accordion_item' %}
          <div class="acc-item{% if forloop.index == 1 %} open{% endif %}"{{ block.shopify_attributes }}>
            <button type="button" class="acc-head">{{ block.settings.title }} <span class="plus">+</span></button>
            <div class="acc-body"><p>{{ block.settings.body }}</p></div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shipping page",
  "settings": [
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Shipping & delivery" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Straight to your door, on time" },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero subtext", "default": "We ship every order from the Netherlands. Here's exactly what it costs and how long it takes." },
    { "type": "text", "id": "countries_heading", "label": "Countries heading", "default": "Where we ship" },
    { "type": "textarea", "id": "countries_subtext", "label": "Countries subtext", "default": "We currently deliver to the following countries. More are on the way." },
    { "type": "text", "id": "info_heading", "label": "Info table heading", "default": "Good to know" },
    { "type": "textarea", "id": "info_subtext", "label": "Info table subtext", "default": "The details that don't fit in a table." }
  ],
  "blocks": [
    {
      "type": "ship_method",
      "name": "Shipping method",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Standard" },
        { "type": "text", "id": "title", "label": "Title", "default": "Standard shipping" },
        { "type": "text", "id": "price_line", "label": "Price line", "default": "€3,95 · free over €25" },
        { "type": "textarea", "id": "details", "label": "Details (one per line)", "default": "Arrives within 5 business days\nFree automatically on orders over €25\nTracking link emailed once it ships" },
        { "type": "checkbox", "id": "emphasize", "label": "Emphasize card (dark border)", "default": false }
      ]
    },
    {
      "type": "country",
      "name": "Country",
      "settings": [{ "type": "text", "id": "name", "label": "Country name" }]
    },
    {
      "type": "info_row",
      "name": "Info table row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    },
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "ship_method", "settings": { "tag": "Standard", "title": "Standard shipping", "price_line": "€3,95 · free over €25", "details": "Arrives within 5 business days\nFree automatically on orders over €25\nTracking link emailed once it ships", "emphasize": false } },
      { "type": "ship_method", "settings": { "tag": "Express", "title": "Express shipping", "price_line": "€2,99", "details": "Order before 15:00 on a business day\nArrives the next business day\nTracking link emailed once it ships", "emphasize": true } },
      { "type": "country", "settings": { "name": "Netherlands" } },
      { "type": "country", "settings": { "name": "Belgium" } },
      { "type": "info_row", "settings": { "label": "Dispatch time", "value": "Orders are dispatched within 1 business day" } },
      { "type": "info_row", "settings": { "label": "Order cut-off", "value": "Orders placed before 15:00 on a business day ship the same day" } },
      { "type": "info_row", "settings": { "label": "Carrier", "value": "All orders are shipped via PostNL" } },
      { "type": "accordion_item", "settings": { "title": "What if I'm not home for delivery?", "body": "PostNL will leave your parcel with a neighbour or at a nearby pick-up point, and let you know where via text or email." } },
      { "type": "accordion_item", "settings": { "title": "My order hasn't arrived yet — what do I do?", "body": "Check your tracking link first. Still stuck after the expected delivery date? Get in touch and we'll chase it up with PostNL." } }
    ]
  },
  "presets": [{ "name": "Shipping page" }]
}
{% endschema %}
