<footer>
  <div class="container">
    <div class="foot-grid">
      <div>
        {% if section.settings.logo_image %}
          {{ section.settings.logo_image | image_url: width: 400 | image_tag: alt: section.settings.logo_text, style: 'height:28px;width:auto;display:block;margin-bottom:14px;' }}
        {% else %}
          <div class="foot-logo">{{ section.settings.logo_text }}</div>
        {% endif %}
        <p>{{ section.settings.tagline }}</p>
      </div>
      <div class="foot-col">
        <h4>{{ section.settings.shop_heading }}</h4>
        {% for block in section.blocks %}
          {% if block.type == 'shop_link' %}
            <a href="{{ block.settings.link }}"{{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {% endif %}
        {% endfor %}
      </div>
      <div class="foot-col">
        <h4>{{ section.settings.support_heading }}</h4>
        {% for block in section.blocks %}
          {% if block.type == 'support_link' %}
            <a href="{{ block.settings.link }}"{{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {% endif %}
        {% endfor %}
      </div>
      <div class="foot-col">
        <h4>{{ section.settings.follow_heading }}</h4>
        {% for block in section.blocks %}
          {% if block.type == 'social_link' %}
            <a href="{{ block.settings.link }}"{{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="foot-bottom">
      <span>{{ section.settings.copyright }}</span>
      <span>{{ section.settings.shipping_note }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text (used if no image is uploaded)", "default": "CAPSLOCK" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (optional)" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Festival caps, made to be worn to the front row and back. Designed in the Netherlands, embroidered to last." },
    { "type": "text", "id": "shop_heading", "label": "Shop column heading", "default": "Shop" },
    { "type": "text", "id": "support_heading", "label": "Support column heading", "default": "Support" },
    { "type": "text", "id": "follow_heading", "label": "Follow column heading", "default": "Follow" },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "© 2026 CAPSLOCK. All rights reserved." },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Shipping to the Netherlands & Belgium" }
  ],
  "blocks": [
    {
      "type": "shop_link",
      "name": "Shop link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "support_link",
      "name": "Support link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "shop_link", "settings": { "label": "All caps", "link": "/collections/all" } },
      { "type": "shop_link", "settings": { "label": "New arrivals", "link": "/collections/all" } },
      { "type": "shop_link", "settings": { "label": "Best sellers", "link": "/collections/all" } },
      { "type": "support_link", "settings": { "label": "Sizing & fit", "link": "/pages/faq" } },
      { "type": "support_link", "settings": { "label": "Shipping & delivery", "link": "/pages/shipping-delivery" } },
      { "type": "support_link", "settings": { "label": "Returns", "link": "/pages/return-policy" } },
      { "type": "support_link", "settings": { "label": "Contact us", "link": "/pages/contact" } },
      { "type": "social_link", "settings": { "label": "Instagram", "link": "#" } },
      { "type": "social_link", "settings": { "label": "TikTok", "link": "#" } }
    ]
  }
}
{% endschema %}
