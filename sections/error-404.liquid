<section class="error-section">
  <div class="error-ring"></div>
  <div class="error-inner">
    <div class="error-num">{{ section.settings.code }}</div>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.body }}</p>
    <div class="error-ctas">
      <a href="/" class="btn btn-primary">{{ section.settings.primary_label }}</a>
      <a href="{{ section.settings.secondary_link }}" class="btn btn-outline">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "code",
      "label": "Error code",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wrong key, wrong page"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "This page doesn't exist — but the caps still do. Let's get you back on track."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Back to homepage"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Shop all caps"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "default": "/collections/all"
    }
  ]
}
{% endschema %}
