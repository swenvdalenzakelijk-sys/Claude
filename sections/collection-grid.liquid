<section class="section" id="shop">
  <div class="container">

    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>

    {% assign coll = section.settings.collection %}

    {% if coll != blank and coll.products_count > 0 %}

      <div class="grid-3">

        {% assign shown = 0 %}

        {%- comment -%} In-stock variants first {%- endcomment -%}
        {% for product in coll.products %}
          {% for variant in product.variants %}
            {% if variant.available and shown < section.settings.max_products %}
              {% assign is_bestseller = false %}
              {% if section.settings.show_bestseller_tag and product.tags contains section.settings.bestseller_label and forloop.first %}
                {% assign is_bestseller = true %}
              {% endif %}
              {% render 'variant-card', product: product, variant: variant, meta_text: section.settings.card_meta_text, show_tag: is_bestseller, tag_label: section.settings.bestseller_label %}
              {% assign shown = shown | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endfor %}

        {%- comment -%} Sold-out variants after {%- endcomment -%}
        {% for product in coll.products %}
          {% for variant in product.variants %}
            {% unless variant.available %}
              {% if shown < section.settings.max_products %}
                {% render 'variant-card', product: product, variant: variant, meta_text: section.settings.card_meta_text, show_tag: false, tag_label: '' %}
                {% assign shown = shown | plus: 1 %}
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% endfor %}

      </div>

      {% if section.settings.button_label != blank %}
        <div class="grid-cta">
          <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}

    {% else %}

      <div class="card placeholder">
        <div class="card-img">
          <div class="ph-ring"></div>
        </div>

        <div class="card-body">
          <div class="cname">
            Geen producten gevonden
          </div>

          <div class="cmeta">
            Selecteer een collectie in de Theme Editor.
          </div>
        </div>
      </div>

    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every cap, one loud statement. New designs land throughout the festival season."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Variants to show (each colour is its own tile)",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "card_meta_text",
      "label": "Card meta line",
      "default": "Embroidered · Adjustable strap"
    },
    {
      "type": "checkbox",
      "id": "show_bestseller_tag",
      "label": "Show bestseller tag",
      "default": true
    },
    {
      "type": "text",
      "id": "bestseller_label",
      "label": "Bestseller tag",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "All styles"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
