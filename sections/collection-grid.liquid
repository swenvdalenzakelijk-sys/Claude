<section class="section" id="shop">
  <div class="container">

    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>

    {% assign coll = section.settings.collection %}

    {% if coll != blank and coll.products_count > 0 %}

      <div class="grid-3">

        {% for product in coll.products limit: section.settings.max_products %}

          <article class="product-card">

            <a href="{{ product.url }}" class="product-card-link">

              <div class="card-img">

                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400,600,800',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      alt: product.title
                  }}
                {% else %}
                  <div class="ph-ring"></div>
                {% endif %}

                {% if section.settings.show_bestseller_tag and product.tags contains section.settings.bestseller_label %}
                  <span class="pill product-badge">
                    {{ section.settings.bestseller_label }}
                  </span>
                {% endif %}

              </div>

              <div class="card-body">

                <div class="cname">
                  {{ product.title }}
                </div>

                <div class="cmeta">
                  {{ section.settings.card_meta_text }}
                </div>

                <div class="price">
                  {{ product.price | money }}
                </div>

              </div>

            </a>

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="card placeholder">
        <div class="card-img">
          <div class="ph-ring"></div>
        </div>

        <div class="card-body">
          <div class="cname">
            Geen producten gevonden
          </div>

          <div class="cmeta">
            Selecteer een collectie in de Theme Editor.
          </div>
        </div>
      </div>

    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every cap, one loud statement. New designs land throughout the festival season."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "card_meta_text",
      "label": "Card meta line",
      "default": "Embroidered · Adjustable strap"
    },
    {
      "type": "checkbox",
      "id": "show_bestseller_tag",
      "label": "Show bestseller tag",
      "default": true
    },
    {
      "type": "text",
      "id": "bestseller_label",
      "label": "Bestseller tag",
      "default": "Bestseller"
    }
  ]
}
{% endschema %}