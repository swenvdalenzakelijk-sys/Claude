<section class="section page-hero" style="padding-bottom:0;">
  <div class="container">
    <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.heading }}</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <p>{{ section.settings.empty_message }}</p>
        <a href="{{ section.settings.empty_link }}" class="btn btn-primary">{{ section.settings.empty_button }}</a>
      </div>
    {% else %}
      {% form 'cart', cart, class: 'cart-form' %}
        <div class="cart-grid">
          <div class="cart-lines">
            {% for item in cart.items %}
              <div class="cart-line">
                <a href="{{ item.url }}" class="cart-line-img">
                  {% if item.image %}
                    {{ item.image | image_url: width: 200 | image_tag: alt: item.title }}
                  {% endif %}
                </a>
                <div class="cart-line-info">
                  <a href="{{ item.url }}" class="cart-line-title">{{ item.product.title }}</a>
                  {% unless item.variant.title == 'Default Title' %}
                    <div class="cart-line-variant">{{ item.variant.title }}</div>
                  {% endunless %}
                  <div class="cart-line-price">{{ item.final_price | money }}</div>
                  <div class="cart-line-controls">
                    <div class="qty-stepper">
                      <button type="button" class="qty-btn" onclick="capslockUpdateQty({{ forloop.index }}, -1)">−</button>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" id="qty-{{ forloop.index }}" class="qty-input" data-line="{{ forloop.index }}">
                      <button type="button" class="qty-btn" onclick="capslockUpdateQty({{ forloop.index }}, 1)">+</button>
                    </div>
                    <a href="{{ item.url_to_remove }}" class="cart-line-remove">{{ section.settings.remove_label }}</a>
                  </div>
                </div>
                <div class="cart-line-total">{{ item.final_line_price | money }}</div>
              </div>
            {% endfor %}
          </div>

          <div class="cart-summary">
            <div class="cart-summary-row">
              <span>{{ section.settings.subtotal_label }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-summary-discount">{{ section.settings.discount_note }}</p>
            <p class="cart-summary-note">{{ section.settings.shipping_note }}</p>
            <button type="submit" name="checkout" class="btn btn-primary form-submit">{{ section.settings.checkout_label }}</button>
            <a href="{{ section.settings.continue_link }}" class="cart-continue">{{ section.settings.continue_label }}</a>
          </div>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>

<style>
  .cart-empty{ text-align:center; padding:60px 0; }
  .cart-empty p{ color:var(--grey); margin-bottom:24px; font-size:16px; }
  .cart-grid{ display:grid; grid-template-columns:1fr .38fr; gap:50px; align-items:flex-start; }
  .cart-lines{ display:flex; flex-direction:column; }
  .cart-line{
    display:grid; grid-template-columns:90px 1fr auto; gap:18px; align-items:flex-start;
    padding:24px 0; border-bottom:1px solid var(--hairline);
  }
  .cart-line-img{ display:block; background:var(--paper); border-radius:12px; overflow:hidden; }
  .cart-line-img img{ width:100%; display:block; }
  .cart-line-title{ font-weight:600; font-size:15px; display:block; margin-bottom:4px; }
  .cart-line-variant{ font-size:13px; color:var(--grey); margin-bottom:8px; }
  .cart-line-price{ font-size:13.5px; color:var(--grey); margin-bottom:12px; }
  .cart-line-controls{ display:flex; align-items:center; gap:16px; }
  .qty-stepper{ display:flex; align-items:center; border:1px solid var(--hairline); border-radius:100px; overflow:hidden; }
  .qty-btn{ width:32px; height:32px; background:var(--paper); font-size:16px; cursor:pointer; }
  .qty-input{
    width:42px; text-align:center; border:none; border-left:1px solid var(--hairline); border-right:1px solid var(--hairline);
    height:32px; font-family:var(--body); font-size:13.5px; -moz-appearance:textfield;
  }
  .qty-input::-webkit-outer-spin-button, .qty-input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
  .cart-line-remove{ font-size:12.5px; color:var(--red); text-decoration:underline; text-underline-offset:3px; }
  .cart-line-total{ font-weight:700; font-size:15px; white-space:nowrap; }
  .cart-summary{
    background:var(--white); border:1px solid var(--hairline); border-radius:18px; padding:28px; position:sticky; top:100px;
  }
  .cart-summary-row{ display:flex; justify-content:space-between; font-weight:700; font-size:17px; margin-bottom:10px; }
  .cart-summary-note{ font-size:12.5px; color:var(--grey); margin-bottom:20px; }
  .cart-continue{ display:block; text-align:center; font-size:13px; margin-top:14px; text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:760px){
    .cart-grid{ grid-template-columns:1fr; }
    .cart-line{ grid-template-columns:70px 1fr; }
    .cart-line-total{ grid-column:2; }
  }
</style>

<script>
  function capslockUpdateQty(line, delta) {
    const input = document.getElementById('qty-' + line);
    if (!input) return;
    const newVal = Math.max(0, parseInt(input.value || '0', 10) + delta);
    input.value = newVal;
    input.closest('form').submit();
  }
</script>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your bag" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "textarea", "id": "empty_message", "label": "Empty cart message", "default": "Your cart is empty. Let's fix that." },
    { "type": "text", "id": "empty_button", "label": "Empty cart button label", "default": "Shop all caps" },
    { "type": "url", "id": "empty_link", "label": "Empty cart button link", "default": "/collections/all" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "discount_note", "label": "Discount note", "default": "Got a code? Add it at checkout." },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Shipping and taxes calculated at checkout." },
    { "type": "text", "id": "checkout_label", "label": "Checkout button label", "default": "Checkout" },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" },
    { "type": "url", "id": "continue_link", "label": "Continue shopping link", "default": "/collections/all" },
    { "type": "text", "id": "remove_label", "label": "Remove label", "default": "Remove" }
  ]
}
{% endschema %}
