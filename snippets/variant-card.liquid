{%- comment -%}
  Renders one grid card for a single variant.
  Usage: {% render 'variant-card', product: product, variant: variant, meta_text: meta_text, show_tag: show_tag, tag_label: tag_label %}
{%- endcomment -%}
<a href="{{ product.url }}?variant={{ variant.id }}" class="card{% unless variant.available %} card--soldout{% endunless %}" style="display:block;">
  <div class="card-img">
    {% assign card_image = variant.featured_image | default: product.featured_image %}
    {% capture alt_text %}{{ product.title }} — {{ variant.title }}{% endcapture %}
    {% if card_image %}
      {{ card_image | image_url: width: 700, crop: 'center' | image_tag: alt: alt_text }}
    {% endif %}
    <div class="card-tags">
      {% if show_tag %}
        <span class="tag-new">{{ tag_label }}</span>
      {% endif %}
      {% unless variant.available %}
        <span class="tag-soldout">Sold out</span>
      {% endunless %}
    </div>
  </div>
  <div class="card-body">
    <div class="cname">{{ product.title }}</div>
    <div class="cmeta">
      {% capture hex %}{% render 'color-swatch-hex', name: variant.option1 %}{% endcapture %}
      <span class="swatch" style="background:{{ hex | strip }};border-color:{{ hex | strip }};display:inline-block;vertical-align:middle;margin-right:6px;"></span>
      {{ variant.title }} · {{ meta_text }}
    </div>
    <div class="cprice">
      <span class="now">{{ variant.price | money }}</span>
      {% if variant.compare_at_price > variant.price %}
        <span class="was">{{ variant.compare_at_price | money }}</span>
      {% endif %}
    </div>
    {% unless variant.available %}
      <div class="card-notify-hint">Sold out — notify me ↗</div>
    {% endunless %}
  </div>
</a>
